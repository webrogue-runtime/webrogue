interface vulkan {
    check-presence: func() -> bool;

    resource renderer {
        constructor(name: list<u8>);
        register-blob: func(
            res-id: u32,
            buf: list<u8>
        );
        create-shmem: func(
            buf: list<u8>
        ) -> u32;
        create-device-memory-blob: func(
            blob-id: u64,
            size: u64
        ) -> u32;

        resource-unref: func(res-id: u32);
        create-sync: func(value: u64) -> u32;
        sync-unref: func(sync-id: u32);
        sync-read: func(sync-id: u32) -> u64;
        sync-write: func(sync-id: u32, value: u64);
        submit-cmd: func(
            headers: list<u8>,
            cmds: list<u8>,
            syncs: list<u8>
        );
        sync-wait: func(
            %flags: u32,
            timeout: u32,
            syncs: list<u32>,
        ) -> s32;
        get-max-timeline-count: func() -> u32;
        get-capset: func(
            id: u32,
            version: u32
        ) -> list<u8>;
        context-init: func(capset-id: u32);
    }
}

interface cpu-rendering {
    use windowing.{window};

    // TODO return an error if, for example, size changed
    present-pixels: func(
        window: borrow<window>,
        buf: list<u32>,
    );
}

interface device-info {
    get-os-family: func() -> u8;
}

world gfx {
    import windowing;
    import vulkan;
    import cpu-rendering;
    import device-info;
}
