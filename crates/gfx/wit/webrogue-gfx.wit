    variant window-event {
        /// button, down, x, y, is-touch
        mouse-button(tuple<mouse-button, bool, u32, u32, bool>),
        /// x, y
        mouse-motion(tuple<u32, u32>),
        /// down, named-key, physical-key, text
        key(tuple<bool, named-key, physical-key, list<u8>>),
        quit,
        window-resized,
        gl-resized,
    }
