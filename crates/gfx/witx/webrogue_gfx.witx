(typename $size u32)
(typename $window_handle u32)
(typename $window_size u32)
(typename $vk_object u64)

(module $webrogue_gfx
  (import "memory" (memory))

  ;; Window manipulation

  (@interface func (export "make_window")
    (param $out_window (@witx pointer $window_handle))
  )
  (@interface func (export "destroy_window")
    (param $window $window_handle)
  )
  (@interface func (export "get_window_size")
    (param $window $window_handle)
    (param $out_width (@witx pointer $window_size))
    (param $out_height (@witx pointer $window_size))
  )
  (@interface func (export "get_gl_size")
    (param $window $window_handle)
    (param $out_width (@witx pointer $window_size))
    (param $out_height (@witx pointer $window_size))
  )

  ;; Events

  (@interface func (export "poll")
    (param $out_len (@witx pointer $size))
  )
  (@interface func (export "poll_read")
    (param $buf (@witx pointer u8))
  )

  ;; Vulkan

  (@interface func (export "check_vk")
    (param $out (@witx pointer u8))
  )
  (@interface func (export "vulkan_register_blob")
    (param $res_id u32)
    (param $buf (@witx pointer u8))
    (param $buf_len $size)
  )
  (@interface func (export "vulkan_create_blob")
    (param $ptr (@witx pointer u8))
    (param $size $size)
    (param $blob_id u64)
    (param $out_res_id (@witx pointer u32))
  )
  (@interface func (export "vulkan_resource_unref")
    (param $res_id u32)
  )
  (@interface func (export "vulkan_sync_create")
    (param $value u64)
    (param $out_sync_id (@witx pointer u32))
  )
  (@interface func (export "vulkan_sync_unref")
    (param $sync_id u32)
  )
  (@interface func (export "vulkan_sync_read")
    (param $sync_id u32)
    (param $out_value (@witx pointer u64))
  )
  (@interface func (export "vulkan_sync_write")
    (param $sync_id u32)
    (param $value u64)
  )
  (@interface func (export "vulkan_submit_cmd")
    (param $headers (@witx pointer u8))
    (param $headers_len $size)
    (param $cmds (@witx pointer u8))
    (param $cmds_len $size)
    (param $syncs (@witx pointer u8))
    (param $syncs_len $size)
  )
  (@interface func (export "vulkan_sync_wait")
    (param $flags u32)
    (param $timeout u32)
    (param $syncs (@witx pointer u8))
    (param $syncs_len $size)
    (param $out_result (@witx pointer u32))
  )
  (@interface func (export "vulkan_get_max_timeline_count")
    (param $out_value (@witx pointer u32))
  )
  (@interface func (export "vulkan_get_capset")
    (param $id u32)
    (param $version u32)
    (param $capset (@witx pointer u8))
    (param $capset_size $size)
    (param $out_size (@witx pointer u32))
  )
  (@interface func (export "vulkan_context_init")
    (param $capset_id u32)
  )
  (@interface func (export "vulkan_create_renderer")
    (param $name (@witx pointer u8))
    (param $name_len $size)
  )
  
  ;; CPU rendering

  (@interface func (export "present_pixels")
    (param $window $window_handle)
    (param $buf (@witx pointer u8))
    (param $len $size)
    (param $out_error (@witx pointer u8))
  )
)
